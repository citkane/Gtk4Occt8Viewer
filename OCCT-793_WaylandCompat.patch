diff --git c/CMakeLists.txt w/CMakeLists.txt
index f8d62e06b7..d420b0ec91 100644
--- c/CMakeLists.txt
+++ w/CMakeLists.txt
@@ -1401,4 +1401,7 @@ endforeach()
 # to have correct paths to libraries depending on the configuration
 OCCT_UPDATE_TARGET_FILE ()
 
+# Check for system Wayland compatibility and compile run-time flag
+OCCT_INCLUDE_CMAKE_FILE("adm/cmake/wayland_compat")
+
 message (STATUS "Info: \(${CURRENT_TIME}\) OCCT configuration files prepared")
diff --git c/adm/cmake/wayland_compat.cmake w/adm/cmake/wayland_compat.cmake
new file mode 100644
index 0000000000..99e51710e5
--- /dev/null
+++ w/adm/cmake/wayland_compat.cmake
@@ -0,0 +1,15 @@
+# Compile definition for Wayland compatibility
+if(UNIX
+   AND NOT USE_GLES2
+   AND NOT APPLE
+   AND NOT ANDROID)
+  set(WAYLAND_COMPAT ON)
+  foreach(target ${OCCT_LIBRARIES})
+    target_compile_definitions(${target} PRIVATE WAYLAND_COMPAT=1)
+  endforeach()
+else()
+  set(WAYLAND_COMPAT OFF)
+  foreach(target ${OCCT_LIBRARIES})
+    target_compile_definitions(${target} PRIVATE WAYLAND_COMPAT=0)
+  endforeach()
+endif()
