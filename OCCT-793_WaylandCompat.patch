+//! @file
+//! This file provides macros to determine system runtime compatibility
+//! capabilities. It's primary purpose is to compile both X11 and Wayland
+//! paths for Unix-like systems thus allowing the consumer to select the
+//! appropriate runtime path.
+
+#ifndef _Standard_Macro_Runtime_HeaderFile
+#define _Standard_Macro_Runtime_HeaderFile
+
+//! @def CHECK_ENV_VAL
+//! Compares the value of an environment variable
+//! @returns bool
+#define CHECK_ENV_VAL(key, val)                                                                    \
+  ([&]() -> bool {                                                                                 \
+    const char* result = std::getenv(key);                                                         \
+    return result != nullptr && std::strcmp(result, val) == 0;                                     \
+  }())
+
+//! @def RUN_UNIX_X11
+//! Determine a X11 runtime path on Wayland compatible systems
+//! @returns bool
+#define RUN_UNIX_X11                                                                               \
+  ([]() -> bool {                                                                                  \
+    if (!WAYLAND_COMPAT)                                                                           \
+      return 0;                                                                                    \
+                                                                                                   \
+    return CHECK_ENV_VAL("XDG_SESSION_TYPE", "x11") || CHECK_ENV_VAL("GDK_BACKEND", "x11")         \
+           || CHECK_ENV_VAL("QT_QPA_PLATFORM", "xcb");                                             \
+  }())
+
+//! @def RUN_WAYLAND
+//! Determine a Wayland runtime path on Wayland compatible systems
+//! @returns bool
+#define RUN_WAYLAND                                                                                \
+  ([]() -> bool {                                                                                  \
+    if (!WAYLAND_COMPAT || RUN_UNIX_X11)                                                           \
+      return 0;                                                                                    \
+                                                                                                   \
+    return CHECK_ENV_VAL("XDG_SESSION_TYPE", "wayland") || CHECK_ENV_VAL("GDK_BACKEND", "wayland") \
+           || CHECK_ENV_VAL("QT_QPA_PLATFORM", "wayland");                                         \
+  }())
+
+// Compiler definitions to negate elif macro patterns downstream.
+// This allows for compiling both X11 and Wayland paths.
+#if WAYLAND_COMPAT
+  #define COMPILE_EGL
+  #define COMPILE_XLIB
+#elif defined(HAVE_EGL)
+  #define COMPILE_EGL
+#elif defined(_WIN32)
+  #define COMPILE_WIN32
+#elif defined(HAVE_XLIB)
+  #define COMPILE_XLIB
+#elif defined(__APPLE__)
+  #define COMPILE_APPLE
+#else
+  #define COMPILE_NOOP
+#endif
+
+#endif // _Standard_Macro_Runtime_HeaderFile
