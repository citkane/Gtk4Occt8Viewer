@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(OpenCASCADE)
find_dependency(PkgConfig)
pkg_check_modules(GTK4 REQUIRED IMPORTED_TARGET gtk4)

set(@PROJECT_NAME@_INCLUDE_DIR @PACKAGE_PROJECT_INCLUDE_INSTALL_DIR@)
set(@PROJECT_NAME@_LIBRARY_DIR @PACKAGE_PROJECT_LIBRARY_INSTALL_DIR@)
set(@PROJECT_NAME@_INSTALL_PREFIX @CMAKE_INSTALL_PREFIX@)

add_library(@PROJECT_NAME@::shared SHARED IMPORTED)
add_library(@PROJECT_NAME@::static STATIC IMPORTED)

if(@PROJECT_NAME@_USE_STATIC)
    pkg_check_modules(EGL REQUIRED IMPORTED_TARGET egl)
    set(@PROJECT_NAME@_LIBRARIES @PROJECT_NAME@::static)
else()
    set(@PROJECT_NAME@_LIBRARIES @PROJECT_NAME@::shared)
endif()

set_target_properties(
    @PROJECT_NAME@::shared
    PROPERTIES
        IMPORTED_LOCATION
            "@PACKAGE_PROJECT_LIBRARY_INSTALL_DIR@/lib@PROJECT_NAME@.so"
        INTERFACE_INCLUDE_DIRECTORIES
            "@PACKAGE_PROJECT_INCLUDE_INSTALL_DIR@;${OpenCASCADE_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "${OpenCASCADE_LIBRARIES};PkgConfig::GTK4"
        INTERFACE_LINK_OPTIONS "-Wl,-rpath,\$ORIGIN/../lib"
)

set_target_properties(
    @PROJECT_NAME@::static
    PROPERTIES
        IMPORTED_LOCATION
            "@PACKAGE_PROJECT_LIBRARY_INSTALL_DIR@/lib@PROJECT_NAME@.a"
        INTERFACE_INCLUDE_DIRECTORIES
            "@PACKAGE_PROJECT_INCLUDE_INSTALL_DIR@;${OpenCASCADE_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES
            "${OpenCASCADE_LIBRARIES};PkgConfig::GTK4;PkgConfig::EGL"
        INTERFACE_LINK_OPTIONS "-Wl,-rpath,\$ORIGIN/../lib"
)
